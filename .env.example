# Fashion Agent Backend - Environment Variables
# Copy this file to .env and fill in the values

# Gemini API Key for the LangGraph styling agent
GOOGLE_API_KEY=your-gemini-api-key-here

# Kaggle ngrok tunnel URL (changes every session)
# Start your Kaggle notebook, copy the ngrok URL, and paste it here
KAGGLE_GPU_URL=https://your-ngrok-url.ngrok-free.dev
